# The app calls /api, and the Vite dev server forwards it to the XAMPP API below.
# This lets you sign in from http://localhost:5173 and from this computer's Wi-Fi
# address (for example a phone on the same network) without editing CORS settings.
VITE_API_BASE_URL=/api
# Where the dev server sends /api requests. Change PASAKJA-main if your folder is renamed.
PASAKJA_API_PROXY_TARGET=http://localhost/PASAKJA-main/api

# Playwright capture/audit (scripts/capture-ui.mjs). These are local demo logins
# only — never commit real credentials. Set the write flag to 1 to enable the
# end-to-end ride flow, which creates a real ride.
PASAKJA_URL=http://localhost:5173
PASAKJA_API_BASE=http://localhost/PASAKJA-main/api
PASAKJA_API_HEALTH=http://localhost/PASAKJA-main/api/health
PASAKJA_DEMO_PASSENGER_PHONE=+639000000001
PASAKJA_DEMO_DRIVER_PHONE=+639000000002
PASAKJA_DEMO_ADMIN_PHONE=+639000000003
PASAKJA_DEMO_PASSWORD=your-demo-password
PASAKJA_ALLOW_WRITES=0
