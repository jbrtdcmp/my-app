# Production web root (copied into dist/ by `npm run build`). The PHP API sits next to
# the built files in api/, which has its own .htaccess.
Options -Indexes
RewriteEngine On

# Keep PHP API routes under api/.htaccess; let the client router handle app URLs.
RewriteRule ^api(?:/|$) - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Location for booking and driving, camera for the license photo; nothing else.
  Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=(), usb=()"
  # Always fetch the newest app shell, service worker and manifest; hashed files in assets/ can be cached.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<FilesMatch "^\.(env|git)">
  Require all denied
</FilesMatch>
